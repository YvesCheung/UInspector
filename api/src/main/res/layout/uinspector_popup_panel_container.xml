<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popup_panel"
    android:layout_width="match_parent"
    android:layout_height="@dimen/popup_panel_container_height"
    android:layout_gravity="bottom"
    android:background="#99000000"
    android:orientation="vertical">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/popup_panel_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal" />

    <com.pitaya.mobile.uinspector.ui.panel.tablayout.TabLayout
        android:id="@+id/popup_panel_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>